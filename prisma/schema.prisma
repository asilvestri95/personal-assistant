generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  packingLists  PackingList[]
  defaultItems  DefaultPackingItem[]
  inviteCodesCreated InviteCode[] @relation("CreatedBy")
  sharedListAccess   PackingListShare[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model InviteCode {
  id        String    @id @default(cuid())
  code      String    @unique
  createdBy String
  usedBy    String?
  usedAt    DateTime?
  expiresAt DateTime?
  createdAt DateTime  @default(now())

  creator User @relation("CreatedBy", fields: [createdBy], references: [id])

  @@map("invite_codes")
}

// ─── Packing Defaults ────────────────────────────────────────────────────────

model DefaultPackingItem {
  id        String   @id @default(cuid())
  userId    String
  name      String
  category  String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("default_packing_items")
}

// ─── Packing Lists ───────────────────────────────────────────────────────────

model PackingList {
  id          String            @id @default(cuid())
  userId      String
  name        String
  destination String?
  startDate   DateTime?
  endDate     DateTime?
  status      PackingListStatus @default(PLANNING)
  shareType   ShareType?
  shareToken  String?           @unique
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  user   User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  items  PackingListItem[]
  shares PackingListShare[]

  @@map("packing_lists")
}

enum PackingListStatus {
  PLANNING
  PACKING
  TRAVELING
  COMPLETED
}

enum ShareType {
  PUBLIC
  INVITE_ONLY
}

model PackingListItem {
  id           String   @id @default(cuid())
  listId       String
  name         String
  category     String
  quantity     Int      @default(1)
  bag          String?
  gathered     Boolean  @default(false)
  packed       Boolean  @default(false)
  preTripNotes String?  @db.Text
  postTripNotes String? @db.Text
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  list PackingList @relation(fields: [listId], references: [id], onDelete: Cascade)

  @@map("packing_list_items")
}

model PackingListShare {
  id        String   @id @default(cuid())
  listId    String
  userId    String
  createdAt DateTime @default(now())

  list PackingList @relation(fields: [listId], references: [id], onDelete: Cascade)
  user User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([listId, userId])
  @@map("packing_list_shares")
}
